Options -MultiViews
RewriteEngine On
RewriteBase /

# Never hijack the backend Python app (mounted at /backend)
RewriteRule ^backend(/.*)?$ - [L]

# Serve real files and folders as-is
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else -> React entry point (client-side routing)
RewriteRule ^ index.html [L]
